# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real API keys.

# Used by android/app/build.gradle (injected into AndroidManifest.xml as the
# Maps SDK for Android key) — must be restricted to Android apps (package
# com.tasmobile + release SHA-1) in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your-android-restricted-maps-key-here

# Used by src/services/GeocodingService.js for plain REST fetch() calls
# (Geocoding API + Distance Matrix API) — must be a SEPARATE key with NO
# Application restriction. An "Android apps" restriction requires
# X-Android-Package/X-Android-Cert headers that Google Play services adds
# automatically for the native Maps SDK, but a manual fetch() never sends
# them, so reusing GOOGLE_MAPS_API_KEY here makes every reverse-geocode call
# fail silently (falls back to raw coordinates instead of a real address).
# Restrict this key by API only (Geocoding API, Distance Matrix API) to keep
# it scoped even though it has no application restriction.
GOOGLE_GEOCODING_API_KEY=your-unrestricted-geocoding-key-here
