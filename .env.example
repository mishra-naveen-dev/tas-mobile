# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real API keys.

# Used by src/services/GeocodingService.js (Geocoding + Distance Matrix REST
# calls) and by android/app/build.gradle (injected into AndroidManifest.xml
# as the Maps SDK for Android key). Same key covers both if it has both
# APIs enabled and is restricted appropriately in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
